{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shapes-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd web && exec portless run"],
      "port": 3000
    },
    {
      "name": "shapes-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd preview && exec portless run"],
      "port": 5173
    },
    {
      "name": "shapes-site-dist",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd preview && npx vite preview --port 5205 --strictPort"],
      "port": 5205
    }
  ]
}
