{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shapes-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "shapes-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "preview", "run", "dev"],
      "port": 5173
    },
    {
      "name": "shapes-site-dist",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd preview && npx vite preview --port 5205 --strictPort"],
      "port": 5205
    }
  ]
}
