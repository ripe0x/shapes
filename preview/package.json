{
  "name": "shapes-preview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "portless": { "name": "preview.shapes", "appPort": 5173 },
  "description": "Local generative preview harness for the Shapes ERC721 protocol",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "simulate": "tsx scripts/simulate.ts",
    "verify": "tsx scripts/verifyStream.ts",
    "fixtures": "tsx scripts/genFixtures.ts",
    "sweep": "tsx scripts/collisionSweep.ts",
    "ink:tune": "tsx scripts/inkTuning.ts",
    "standalone": "tsx scripts/buildStandalone.ts",
    "gif:e2e": "node scripts/e2eGif.mjs",
    "test": "tsx --test src/canonical/*.test.ts src/site/*.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@noble/hashes": "^1.8.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.55.11",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
