# Local anvil deploy target. Values only; sourced by script/deploy.sh.

CHAIN_ID=31337
RPC_DEFAULT=http://127.0.0.1:8545

# Empty: the local flow deploys Shapes first (see README, "Deploying"), then passes its address
# in the environment: SHAPES=0x... script/deploy.sh anvil
SHAPES=

# Empty: the presentation admin defaults to the broadcaster (anvil account 0).
ADMIN=
