# Mainnet deploy target. Values only, no secrets; sourced by script/deploy.sh.
# Signing: set PRIVATE_KEY, or KEYSTORE_ACCOUNT (a name under ~/.foundry/keystores) in the shell.
# Verification needs ETHERSCAN_API_KEY in the shell. script/deploy.sh refuses to run without
# CONFIRM_MAINNET=yes.

CHAIN_ID=1
RPC_DEFAULT=https://gateway.tenderly.co/public/mainnet

# The deployed Shapes. Deploy.s.sol rejects any other address on chain 1.
SHAPES=0x6fe9193276bf7abcbee44ab7afd717d637d6faf0

# Empty: the presentation admin defaults to the broadcaster. Set a multisig for the real launch;
# the admin can replace the renderer and edit the copy until presentation is locked.
ADMIN=
