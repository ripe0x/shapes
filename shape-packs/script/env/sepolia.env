# Sepolia deploy target. Values only, no secrets; sourced by script/deploy.sh.
# Signing: set PRIVATE_KEY, or KEYSTORE_ACCOUNT (a name under ~/.foundry/keystores) in the shell.
# Verification needs ETHERSCAN_API_KEY in the shell.

CHAIN_ID=11155111
RPC_DEFAULT=https://ethereum-sepolia-rpc.publicnode.com

# The live Sepolia Shapes (web/public/deployment.sepolia.json in the Shapes repository).
SHAPES=0x6c2f9c00f44fbbf141dd166979903004b80d5f99

# Empty: the presentation admin defaults to the broadcaster. Set a multisig here for a launch.
ADMIN=
