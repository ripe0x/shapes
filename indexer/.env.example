# Copy this file to .env.local (Ponder loads .env.local automatically) and fill in the values
# for the chain you're indexing. Nothing here has a default for SHAPES_ADDRESS or
# SHAPES_START_BLOCK on purpose: an indexer that silently starts against the wrong contract, or
# rescans from block 0 against a live chain, is worse than one that refuses to start.

# --- Dev chain (values from preview/public/deployment.json as of this writing) ---
PONDER_RPC_URL=http://127.0.0.1:8547
PONDER_RPC_FALLBACKS=
PONDER_POLL_INTERVAL_MS=1000
PONDER_CHAIN_ID=31347
SHAPES_LADDER=mainnet
SHAPES_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# Block the dev chain's Shapes contract was deployed at. 0 is fine for a fresh local anvil chain.
SHAPES_START_BLOCK=0

# --- Mainnet (not deployed yet) ---
# PONDER_RPC_URL=https://ethereum-rpc.publicnode.com
# PONDER_CHAIN_ID=1
# SHAPES_ADDRESS=0x0000000000000000000000000000000000000000  # TODO: fill in after mainnet deploy
# SHAPES_START_BLOCK=0                                        # TODO: fill in the deploy block

# --- Storage ---
# Ponder uses embedded PGlite here unless DATABASE_URL is set. On Fly, point this directory at
# the mounted persistent volume. Local development can keep the default `.ponder/pglite` path.
# PONDER_DATABASE_DIR=/data/pglite
# Postgres remains an optional future scale-up path, not a Shapes launch dependency.
# DATABASE_URL=postgres://user:password@localhost:5432/shapes_indexer
