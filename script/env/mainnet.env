# Mainnet deploy target. Values only, no secrets; sourced by script/deploy.sh.
#
# D-05 (project/DECISIONS.md) must be resolved and DEPLOYER, FEE_RECIPIENT and MINT_FEE_WEI filled
# in below before this file can drive a deploy. script/deploy.sh refuses to run, including under
# DRY_RUN, while any required value here is empty.

CHAIN_ID=1
FOUNDRY_PROFILE_DEFAULT=default
RPC_DEFAULT=
VERIFY=true
REQUIRE_MAIN=true
FEE_RECIPIENT_MUST_BE_EOA=true
WALLET=keystore
KEYSTORE_ACCOUNT=ripe0x
DEPLOYER=
FEE_RECIPIENT=
MINT_FEE_WEI=
# 2026-09-03 12:00 ET (16:00 UTC)
MINT_START=1788796800

# Empty: off by default. Set to 1 (here or as a shell export, which wins) to list the owner
# token (#0) in the auction house as part of deploy.sh.
LIST_OWNER_TOKEN=
AUCTION_DURATION=86400
AUCTION_RESERVE_UNITS=0
AUCTION_MIN_INCREMENT_BPS=500
AUCTION_EXTENSION_WINDOW=900
