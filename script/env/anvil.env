# Local Anvil deploy target. Values only; sourced by script/deploy.sh.

CHAIN_ID=31337
FOUNDRY_PROFILE_DEFAULT=default
RPC_DEFAULT=http://127.0.0.1:8545
VERIFY=false
REQUIRE_MAIN=false
BRANCH_DEPLOY_ALLOWED=true
WALLET=anvil

# Empty: deploys a fresh core. Set to an already-deployed Shapes address to deploy only a new
# auction house against it and move the market pointer, leaving the core untouched.
SHAPES_ADDRESS=

# Empty: Deploy.s.sol defaults the mint fee and, on chain id 31337 only, the fee recipient too.
MINT_FEE_WEI=
FEE_RECIPIENT=
MINT_START=0

# Empty: off by default. Set to 1 (here or as a shell export, which wins) to list the owner
# token (#0) in the auction house as part of deploy.sh.
LIST_OWNER_TOKEN=
AUCTION_DURATION=86400
AUCTION_RESERVE_UNITS=0
AUCTION_MIN_INCREMENT_BPS=500
AUCTION_EXTENSION_WINDOW=900
# Absolute unix seconds; empty or 0 opens the listing at creation.
AUCTION_START_TIME=
