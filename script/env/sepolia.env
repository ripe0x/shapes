# Sepolia deploy target. Values only, no secrets; sourced by script/deploy.sh.

CHAIN_ID=11155111
FOUNDRY_PROFILE_DEFAULT=testnet
RPC_DEFAULT=https://ethereum-sepolia-rpc.publicnode.com
VERIFY=true
REQUIRE_MAIN=true
# Rehearsals from a feature branch are allowed here: ALLOW_BRANCH_DEPLOY=1 replaces the
# must-be-main guard with an exact-commit check against the current branch instead.
BRANCH_DEPLOY_ALLOWED=true
WALLET=keystore
KEYSTORE_ACCOUNT=ripe0x
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
FEE_RECIPIENT=0x41c3BD8A36f8fE9Bb77900ca02400b32BB35A6A4
MINT_FEE_WEI=10000000000000
# Empty: a rehearsal sets this a few minutes ahead by exporting SHAPES_MINT_START before calling
# deploy.sh, to prove the gate on a real network without waiting for the mainnet start time.
MINT_START=
INDEXER_URL=https://shapes-indexer.fly.dev

# The live Sepolia Shapes, so a rehearsal deploys only a new auction house against it, mirroring
# the mainnet cutover. A full Sepolia redeploy passes SHAPES_ADDRESS= (empty) on the command line
# to override this.
SHAPES_ADDRESS=0x6c2f9c00f44fbbf141dd166979903004b80d5f99

# Empty: off by default. Set to 1 (here or as a shell export, which wins) to list the owner
# token (#0) in the auction house as part of deploy.sh.
LIST_OWNER_TOKEN=
AUCTION_DURATION=86400
AUCTION_RESERVE_UNITS=0
AUCTION_MIN_INCREMENT_BPS=500
AUCTION_EXTENSION_WINDOW=900
# Absolute unix seconds; empty or 0 opens the listing at creation.
AUCTION_START_TIME=
